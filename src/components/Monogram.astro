---
import { MONOGRAM_PATH } from '../lib/monogram';
const { size = 40 } = Astro.props;
---

<svg
  class="monogram"
  viewBox="819 170 323 293"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <path fill="currentColor" fill-rule="evenodd" d={MONOGRAM_PATH} />
</svg>

<style>
  .monogram {
    display: block;
    color: var(--brand);
  }
</style>