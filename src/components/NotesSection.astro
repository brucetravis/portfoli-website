---
const { action = '#' } = Astro.props;
---

<section class="notes" aria-labelledby="notes-title">
    <div class="notes__text">
        <h2 id="notes-title">Notes</h2>
        <p>[Promise line — what you send, and how often.]</p>
    </div>

    <form class="notes__form" action={action} method="post">
        <label for="notes-email">Email address</label>
        <div class="notes__row">
            <input
                id="notes-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
            />
            <button type="submit">Subscribe</button>
        </div>
        <p class="notes__small">No spam. Unsubscribe any time.</p>
    </form>
</section>

<style>
    .notes {
        padding: clamp(64px, 10vw, 144px) clamp(16px, 4vw, 64px);
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 64px;
    }
    .notes__text { max-width: 620px; display: flex; flex-direction: column; gap: 16px; }
    .notes__text h2 {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(40px, 5vw, 72px);
        line-height: 1;
        color: var(--brand);
    }
    .notes__text p { margin: 0; font-size: 19px; line-height: 1.55; }

    .notes__form { width: min(520px, 100%); display: flex; flex-direction: column; gap: 10px; }
    label {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--muted);
    }
    .notes__row { display: flex; gap: 12px; }

    input {
        flex: 1;
        height: 52px;
        padding: 0 16px;
        background: var(--surface);
        border: 1px solid var(--border-strong);
        border-radius: 0;
        color: var(--text);
        font: inherit;
        font-size: 16px;
    }
    input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    button {
        height: 52px;
        padding: 0 28px;
        background: var(--brand);
        color: var(--bg);
        border: none;
        font: inherit;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background 150ms;
    }
    button:hover { background: var(--accent); }
    button:active { transform: translateY(1px); }
    button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    .notes__small { margin: 0; font-size: 13px; color: var(--muted); }

    @media (max-width: 767px) {
        .notes { flex-direction: column; align-items: stretch; gap: 32px; }
        .notes__row { flex-direction: column; }
    }
</style>