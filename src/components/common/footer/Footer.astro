---
import Monogram from '../../Monogram.astro';

const socials = [
    { label: 'GitHub', short: 'GH', href: '#' },
    { label: 'LinkedIn', short: 'IN', href: '#' },
    { label: 'X', short: 'X', href: '#' },
    { label: 'Email', short: '@', href: '#' },
];

const year = new Date().getFullYear();
---

<footer class="footer">
    <div class="footer__left">
        <a class="footer__logo" href="/" aria-label="Bruce Travis — home">
            <Monogram size={24} />
        </a>
        <span>© {year} Bruce Travis</span>
    </div>

    <p class="footer__colophon">
        <a class="link" href="https://neurorainnovations.com">
            Neurora Innovations <span class="arrow" aria-hidden="true">↗</span>
        </a>
    </p>

    <ul class="footer__socials">
        {socials.map((s) => (
            <li><a href={s.href} aria-label={s.label}>{s.short}</a></li>
        ))}
    </ul>
</footer>

<style>
    .footer {
        border-top: 1px solid var(--border);
        padding: 32px clamp(16px, 4vw, 64px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        font-size: 14px;
        color: var(--muted);
    }
    .footer__left { display: flex; align-items: center; gap: 16px; }
    .footer__left .link { font-size: 14px; }

    .footer__colophon {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 12px;
        text-transform: uppercase;
    }

    .footer__socials { list-style: none; margin: 0; padding: 0; display: flex; gap: 12px; }
    .footer__socials a {
        width: 44px; height: 44px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid var(--border);
        border-radius: 50%;
        color: var(--brand);
        font-family: var(--font-mono);
        font-size: 11px;
        text-decoration: none;
        transition: color 150ms, border-color 150ms;
    }
    .footer__socials a:hover,
    .footer__socials a:focus-visible { color: var(--accent); border-color: var(--accent); }
    .footer__socials a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

    .footer__logo { display: block; }
    .footer__logo :global(.monogram) {
        transition: filter 300ms cubic-bezier(0.2, 0, 0, 1);
    }
    
    @media (hover: hover) {
        .footer__logo:hover :global(.monogram) {
            filter: drop-shadow(0 0 8px var(--glow-near)) drop-shadow(0 0 30px var(--glow-far));
        }
    }
    .footer__logo:focus-visible :global(.monogram) {
        filter: drop-shadow(0 0 8px var(--glow-near)) drop-shadow(0 0 30px var(--glow-far));
    }
    .footer__logo:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

    @media (max-width: 767px) {
        .footer { flex-direction: column; align-items: flex-start; }
        .footer__left { flex-wrap: wrap; }
    }
</style>