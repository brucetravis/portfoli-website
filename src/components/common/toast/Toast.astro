---
// Site-wide toast notifications. Include once in BaseLayout, then anywhere call:
//   window.toast({ kind: 'success' | 'info' | 'error', title: '...', msg: '...' })
---
<div class="toasts" id="bt-toasts" role="status" aria-live="polite" aria-atomic="false"></div>

<script>
    type ToastKind = 'success' | 'info' | 'error';
    interface ToastOpts { kind?: ToastKind; title: string; msg?: string; duration?: number; }

    const host = document.getElementById('bt-toasts')!;
    const ICON: Record<ToastKind, string> = { success: '✓', info: '→', error: '!' };

    function toast({ kind = 'info', title, msg, duration = 4500 }: ToastOpts) {
        const el = document.createElement('div');
        el.className = 'toast';
        el.dataset.kind = kind;
        el.innerHTML =
        '<span class="toast__icon" aria-hidden="true">' + ICON[kind] + '</span>' +
        '<div class="toast__body"><p class="toast__title"></p>' + (msg ? '<p class="toast__msg"></p>' : '') + '</div>' +
        '<button class="toast__close" aria-label="Dismiss">&times;</button>' +
        '<span class="toast__bar" aria-hidden="true"></span>';
        el.querySelector('.toast__title')!.textContent = title;
        if (msg) el.querySelector('.toast__msg')!.textContent = msg;

        const close = () => {
        if (el.classList.contains('is-out')) return;
        el.classList.add('is-out');
        el.addEventListener('animationend', () => el.remove(), { once: true });
        };
        el.querySelector('.toast__close')!.addEventListener('click', close);
        host.appendChild(el);

        const timer = setTimeout(close, duration);
        el.addEventListener('pointerenter', () => clearTimeout(timer)); // pause on hover
        return close;
    }

    // Expose it for form scripts on any page
    (window as any).toast = toast;
</script>

<style is:global>
    .toasts {
        position: fixed;
        left: 50%;
        bottom: calc(28px + env(safe-area-inset-bottom, 0px));
        transform: translateX(-50%);
        z-index: 1000;
        display: flex;
        flex-direction: column;
        gap: 12px;
        width: min(440px, calc(100% - 32px));
        pointer-events: none;
    }

    .toast {
        pointer-events: auto;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 16px 16px 16px 18px;
        background: var(--surface);
        border: 1px solid var(--border);
        box-shadow: 0 12px 40px rgb(0 0 0 / 0.5);
        animation: toast-in 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .toast.is-out { animation: toast-out 300ms cubic-bezier(0.16, 1, 0.3, 1) forwards; }

    .toast::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: var(--accent);
    }
    .toast[data-kind='success']::before { background: var(--ok, #6FBF73); }
    .toast[data-kind='error']::before { background: var(--err, #C8685A); }

    .toast__icon {
        flex-shrink: 0;
        width: 22px;
        height: 22px;
        margin-top: 1px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        border: 1px solid var(--accent);
        color: var(--accent);
    }
    .toast[data-kind='success'] .toast__icon { border-color: var(--ok, #6FBF73); color: var(--ok, #6FBF73); }
    .toast[data-kind='error'] .toast__icon { border-color: var(--err, #C8685A); color: var(--err, #C8685A); }

    .toast__body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .toast__title { margin: 0; font-size: 15px; font-weight: 600; color: var(--text); }
    .toast__msg { margin: 0; font-size: 14px; line-height: 1.45; color: var(--muted); }

    .toast__close {
        flex-shrink: 0;
        margin-left: auto;
        width: 28px;
        height: 28px;
        background: transparent;
        border: none;
        color: var(--muted);
        font-size: 18px;
        line-height: 1;
        cursor: pointer;
        border-radius: 4px;
    }
    .toast__close:hover { color: var(--text); }

    .toast__bar {
        position: absolute;
        left: 0;
        bottom: 0;
        height: 2px;
        width: 100%;
        background: var(--accent);
        opacity: 0.5;
        transform-origin: left;
        animation: toast-drain 4500ms linear forwards;
    }
    .toast[data-kind='success'] .toast__bar { background: var(--ok, #6FBF73); }
    .toast[data-kind='error'] .toast__bar { background: var(--err, #C8685A); }

    @keyframes toast-in { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
    @keyframes toast-out { to { opacity: 0; transform: translateY(8px); } }
    @keyframes toast-drain { from { transform: scaleX(1); } to { transform: scaleX(0); } }

    @media (prefers-reduced-motion: reduce) {
        .toast { animation: toast-fade 300ms ease both; }
        .toast.is-out { animation: toast-fadeout 200ms ease forwards; }
        .toast__bar { animation: none; opacity: 0; }
        @keyframes toast-fade { from { opacity: 0; } to { opacity: 1; } }
        @keyframes toast-fadeout { to { opacity: 0; } }
    }
</style>