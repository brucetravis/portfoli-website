---
interface Props {
    title: string;
    label?: string;
    as?: 'span' | 'h2' | 'h3';
    ratio?: string;
}

const { title, label, as: Tag = 'span', ratio = '4 / 5' } = Astro.props;
---

<div class="cover" style={`--ratio: ${ratio}`}>
    <Tag class="cover__title">{title}</Tag>
    {label && <span class="cover__label">{label}</span>}
</div>

<style>
    .cover {
        container-type: inline-size;
        aspect-ratio: var(--ratio);
        width: 100%;
        height: 100%;
        background: var(--surface);
        border: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4cqi;
        padding: 8cqi;
        text-align: center;
        box-sizing: border-box;
        transition: border-color 300ms ease;
    }

    .cover__title {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(28px, 12cqi, 120px);
        line-height: 1;
        color: var(--brand);
        transition: text-shadow 300ms ease;
    }

    .cover__label {
        font-family: var(--font-mono);
        font-size: clamp(12px, 3.5cqi, 28px);
        letter-spacing: 0.2em;
        color: var(--muted);
    }
</style>