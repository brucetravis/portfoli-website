---
// Light sweep: a soft band of light crosses the hero photo behind clear glass,
// once the particle intro has played. The face stays sharp; only a gentle bend
// rides the light band, and the face is kept out of that bend.
---
<canvas class="hero__glass" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector('.hero__glass') as HTMLCanvasElement;
  const hero = canvas.closest('.hero') as HTMLElement;
  const photo = hero.querySelector('.hero__photo') as HTMLElement;
  const img = hero.querySelector('.hero__img') as HTMLImageElement;

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Where the face sits in the photo (0–1 from left, 0–1 from top). Tune to the real shoot.
  const FACE: [number, number] = [0.70, 0.30];

  function webglOk(): WebGLRenderingContext | null {
    try {
      return canvas.getContext('webgl', { antialias: false, premultipliedAlpha: false });
    } catch {
      return null;
    }
  }

  const gl = reduced ? null : webglOk();

  // No WebGL or reduced motion: leave the plain photo, remove the empty canvas
  if (!gl) {
    canvas.remove();
  } else {
    waitForImage(img).then((bitmap) => start(gl, bitmap));
  }

  function waitForImage(el: HTMLImageElement): Promise<HTMLImageElement> {
    return new Promise((resolve) => {
      if (el.complete && el.naturalWidth) resolve(el);
      else el.addEventListener('load', () => resolve(el), { once: true });
    });
  }

  function start(gl: WebGLRenderingContext, source: HTMLImageElement) {
    const vert = `
      attribute vec2 p; varying vec2 vUv;
      void main() { vUv = p * 0.5 + 0.5; gl_Position = vec4(p, 0.0, 1.0); }`;

    const frag = `
      precision highp float;
      varying vec2 vUv;
      uniform sampler2D uTex;
      uniform vec2 uRes, uImg, uFace;
      uniform float uTime, uStrength, uFade;

      // Screen uv -> image uv, like CSS object-fit: cover, object-position 70% center
      vec2 cover(vec2 uv) {
        float rs = uRes.x / uRes.y, ri = uImg.x / uImg.y;
        vec2 scale = rs > ri ? vec2(1.0, ri / rs) : vec2(rs / ri, 1.0);
        vec2 offset = (1.0 - scale) * vec2(0.7, 0.5);
        return uv * scale + offset;
      }
      vec3 tex(vec2 iuv) { return texture2D(uTex, vec2(iuv.x, 1.0 - iuv.y)).rgb; }

      void main() {
        vec2 uv = vUv;
        vec2 iuv = cover(uv);

        // Keep the bend off the face (the light itself still crosses it)
        float ia = uImg.x / uImg.y;
        vec2 faceImg = vec2(uFace.x, 1.0 - uFace.y);
        float d = distance(vec2(iuv.x * ia, iuv.y), vec2(faceImg.x * ia, faceImg.y));
        float mask = smoothstep(0.08, 0.24, d);

        // One soft diagonal band crossing every 7 seconds
        float cycle = mod(uTime, 7.0) / 7.0;
        float pos = mix(-0.4, 1.4, cycle);
        float band = (uv.x + uv.y * 0.45) - pos;

        float glow = exp(-band * band / 0.004) * uStrength;   // the bright core
        float wide = exp(-band * band / 0.03) * uStrength;    // the soft halo
        float bend = exp(-band * band / 0.02) * uStrength * mask;

        // The image bends very slightly as the band passes (not on the face)
        vec2 off = vec2(bend * 0.010, -bend * 0.005);
        vec3 col = tex(iuv + off);

        // Cream light: a bright line plus a soft wash around it
        col += vec3(0.84, 0.78, 0.73) * glow * 0.14;
        col += vec3(0.84, 0.78, 0.73) * wide * 0.05;

        gl_FragColor = vec4(col, uFade);
      }`;

    const sh = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) console.error(gl.getShaderInfoLog(s));
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, vert));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, frag));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    gl.enable(gl.BLEND);
    gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

    const U: Record<string, WebGLUniformLocation | null> = {};
    ['uTex', 'uRes', 'uImg', 'uFace', 'uTime', 'uStrength', 'uFade'].forEach(
      (n) => (U[n] = gl.getUniformLocation(prog, n))
    );

    const texture = gl.createTexture();
    gl.bindTexture(gl.TEXTURE_2D, texture);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGB, gl.RGB, gl.UNSIGNED_BYTE, source);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    gl.uniform2f(U.uImg, source.naturalWidth, source.naturalHeight);
    gl.uniform2f(U.uFace, FACE[0], FACE[1]);

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      const w = Math.round(photo.clientWidth * dpr);
      const h = Math.round(photo.clientHeight * dpr);
      if (canvas.width === w && canvas.height === h) return;
      canvas.width = w;
      canvas.height = h;
      gl.viewport(0, 0, w, h);
      gl.uniform2f(U.uRes, w, h);
    }
    window.addEventListener('resize', resize);
    resize();

    // Ease the glass in after the intro reveals (or ~1.2s after load if no intro)
    const introPlaying = hero.getAttribute('data-intro') === 'play';
    const glassStart = performance.now() + (introPlaying ? 2400 : 1200);
    const easeIn = (t: number) => 1 - Math.pow(1 - Math.min(Math.max(t, 0), 1), 3);

    // Pause when the hero is off-screen or the tab is hidden
    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.01 }).observe(hero);

    canvas.classList.add('is-on'); // lets CSS fade the canvas in once ready

    function frame(now: number) {
      requestAnimationFrame(frame);
      if (!visible || document.hidden) return;
      resize();
      gl.uniform1i(U.uTex, 0);
      gl.uniform1f(U.uTime, now / 1000);
      gl.uniform1f(U.uStrength, 1.0);
      gl.uniform1f(U.uFade, easeIn((now - glassStart) / 1400));
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    }
    requestAnimationFrame(frame);
  }
</script>

<style>
    .hero__glass {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        opacity: 0;
        transition: opacity 1200ms ease;
        pointer-events: none;
    }
    .hero__glass.is-on { opacity: 1; }
</style>