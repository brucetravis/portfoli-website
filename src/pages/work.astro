---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCover from '../../components/ProjectCover.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('work', ({ data }) => !data.draft))
    .sort((a, b) => a.data.order - b.data.order);

  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { title, summary, year, role, status, stack, cover, label } = project.data;
const { Content } = await render(project);
const hasNext = next.id !== project.id;
---

<BaseLayout title={`${title} — Bruce Travis`}>
    <article class="project">
        <header class="project__head">
        <a class="link project__back" href="/work"><span class="arrow" aria-hidden="true">←</span> All work</a>
        <p class="project__eyebrow">
            Case study · <span class="project__dot" data-status={status} aria-hidden="true">●</span> {status}
        </p>
        <h1 class="project__title">{title}</h1>
        <p class="project__summary">{summary}</p>
        </header>

        <dl class="project__meta">
            <div><dt>Year</dt><dd>{year}</dd></div>
            <div><dt>Role</dt><dd>{role}</dd></div>
            <div><dt>Stack</dt><dd>{stack.join(' · ')}</dd></div>
            {label && <div><dt>Platform</dt><dd>{label}</dd></div>}
        </dl>

        <div class="project__cover">
        {cover ? (
            <Image src={cover} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" />
        ) : (
            <ProjectCover title={title} label={label} ratio="16 / 9" />
        )}
        </div>

        <div class="prose">
        <Content />
        </div>

        {hasNext && (
        <a class="project__next" href={`/work/${next.id}`}>
            <span class="project__next-label">Next project</span>
            <span class="project__next-title">{next.data.title}</span>
            <span class="arrow" aria-hidden="true">→</span>
        </a>
        )}
    </article>
</BaseLayout>

<style>
    .project {
        padding: clamp(48px, 8vw, 120px) clamp(16px, 4vw, 64px) clamp(64px, 10vw, 144px);
        display: flex;
        flex-direction: column;
        gap: clamp(40px, 6vw, 72px);
    }

    .project__head {
        display: flex;
        flex-direction: column;
        gap: 20px;
        max-width: 900px;
    }

    .project__back,
    .project__eyebrow,
    .project__meta dt,
    .project__next-label {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .project__back {
        align-self: flex-start;
    }

    .project__eyebrow {
        margin: 0;
        color: var(--muted);
    }

    .project__dot { color: var(--accent); }
    .project__dot[data-status='Live'] { color: #6FBF73; }
    .project__dot[data-status='Archived'] { color: var(--muted); }

    .project__title {
        margin: 0;
        font-size: clamp(56px, 9vw, 144px);
        line-height: 0.92;
        letter-spacing: -0.02em;
        color: var(--brand);
    }

    .project__summary {
        margin: 0;
        font-size: clamp(19px, 2vw, 24px);
        line-height: 1.5;
        max-width: 640px;
    }

    .project__meta {
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 24px;
        padding: 24px 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }

    .project__meta div {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .project__meta dt { color: var(--muted); }
    .project__meta dd { margin: 0; font-size: 16px; }

    .project__cover :global(img) {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid var(--border);
    }

    /* Styles for the Markdown content (it is not scoped, so :global) */
    .prose {
        max-width: 680px;
        margin-inline: auto;
        width: 100%;
    }

    .prose :global(h2) {
        margin: 64px 0 16px;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(32px, 4vw, 44px);
        line-height: 1.1;
        color: var(--brand);
    }

    .prose :global(h2:first-child) { margin-top: 0; }

    .prose :global(p),
    .prose :global(li) {
        font-size: 18px;
        line-height: 1.7;
    }

    .prose :global(a) {
        color: var(--brand);
        text-decoration: underline;
        text-decoration-color: var(--accent);
        text-underline-offset: 4px;
    }

    .prose :global(img) {
        max-width: 100%;
        height: auto;
        border: 1px solid var(--border);
    }

    .project__next {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: end;
        gap: 8px 24px;
        padding-top: 32px;
        border-top: 1px solid var(--border);
        color: var(--brand);
        text-decoration: none;
    }

    .project__next-label {
        grid-column: 1 / -1;
        color: var(--muted);
    }

    .project__next-title {
        font-family: var(--font-display);
        font-size: clamp(40px, 6vw, 96px);
        line-height: 1;
        transition: color 300ms ease;
    }

    .project__next .arrow {
        font-size: clamp(32px, 4vw, 56px);
        transition: transform 300ms ease, color 300ms ease;
    }

    .project__next:hover .project__next-title,
    .project__next:hover .arrow {
        color: var(--accent);
    }

    .project__next:hover .arrow { transform: translateX(8px); }

    @media (prefers-reduced-motion: reduce) {
        .project__next:hover .arrow { transform: none; }
    }
</style>